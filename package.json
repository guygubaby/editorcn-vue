{
  "name": "editorcn-vue-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter playground dev",
    "build": "pnpm typecheck && pnpm --filter playground build",
    "preview": "pnpm --filter playground preview",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "build:registry": "node scripts/build-registry.mjs",
    "docs:dev": "node scripts/build-llms.mjs && vitepress dev docs",
    "docs:build": "node scripts/build-llms.mjs && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:llms": "node scripts/build-llms.mjs"
  },
  "devDependencies": {
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/vue-3": "^3.32.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  }
}
